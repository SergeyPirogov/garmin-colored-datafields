<?xml version="1.0"?>
<properties>
    <!-- HR Zone thresholds - upper BPM limit for each zone -->
    <!-- Zone 1: Recovery (default up to 115 bpm) -->
    <property id="Zone1Max" type="number">115</property>
    <!-- Zone 2: Endurance/Fat burn (default up to 135 bpm) -->
    <property id="Zone2Max" type="number">135</property>
    <!-- Zone 3: Aerobic/Tempo (default up to 155 bpm) -->
    <property id="Zone3Max" type="number">155</property>
    <!-- Zone 4: Threshold/Lactate (default up to 175 bpm) -->
    <property id="Zone4Max" type="number">175</property>
    <!-- Zone 5: VO2 Max / All-out (default up to 220 bpm) -->
    <property id="Zone5Max" type="number">220</property>
</properties>
